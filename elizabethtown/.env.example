# Elizabethtown pipeline — environment template
# Copy to .env and fill in. Never commit .env.

# MongoDB
MONGO_URL=mongodb://db:27017
MONGO_DB=elizabethtown

# Fetcher
FETCH_BASE_URL=https://www.elizabethtownky.org
FETCH_RATE_LIMIT_RPS=1
FETCH_USER_AGENT=DigitalGovAI-Research/0.1 (contact: your-email@example.com)

# OCR
OCR_ENGINE=tesseract
OCR_LANG=eng

# Search
SEARCH_HOST=0.0.0.0
SEARCH_PORT=8000
